<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rqt_multiplot</name>
  <version>0.0.37</version>
  <description>rqt_multiplot provides a GUI plugin for visualizing numeric values in multiple 2D plots using the Qwt plotting backend.</description>
  <author email="ralf.kaestner@gmail.com">Ralf Kaestner</author>
  <maintainer email="sbachmann@anybotics.com">Samuel Bachmann</maintainer>
  <license>GNU Lesser General Public License v3.0 (LGPL-3.0)</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>libboost-dev</depend>
  <depend>pluginlib</depend>
  <depend>qt_gui_cpp</depend>
  <depend>rclcpp</depend>
  <depend>ros_babel_fish</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosbag2_storage_default_plugins</depend>
  <depend>rosbag2_storage_mcap</depend>
  <depend>rqt_gui</depend>
  <depend>rqt_gui_cpp</depend>
  <depend condition="$ROS_DISTRO == 'jazzy' or $ROS_DISTRO == 'kilted'">qtbase5-dev</depend>
  <depend condition="$ROS_DISTRO == 'jazzy' or $ROS_DISTRO == 'kilted'">libqt5-svg-dev</depend>
  <depend condition="$ROS_DISTRO == 'jazzy' or $ROS_DISTRO == 'kilted'">libqwt-qt5-dev</depend>
  <depend condition="$ROS_DISTRO != 'jazzy' and $ROS_DISTRO != 'kilted'">qt6-base-dev</depend>
  <depend condition="$ROS_DISTRO != 'jazzy' and $ROS_DISTRO != 'kilted'">qt6-svg-dev</depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>clang-tidy</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>rosbag2_storage_mcap</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
